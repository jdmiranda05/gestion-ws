# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Servidor
PORT=3000
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# URL pública para los enlaces de recuperación de contraseña (opcional)
# APP_URL=http://localhost:3000

# Administrador inicial (se crea solo si no existe ningún usuario del personal).
# Si no defines ADMIN_PASSWORD se genera una al azar y se muestra una vez en la consola.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Correo saliente (opcional). Sin SMTP el sistema funciona igual, solo no envía correos.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Mesa de Ayuda <soporte@tuempresa.com>"

# Copias de seguridad (npm run backup)
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# BACKUP_KEEP=14
